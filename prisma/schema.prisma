// Lekker Tours, Postgres schema.
//
// Ported from the original Mongoose models. Two rules shaped the translation:
//
// 1. Anything the public site queries, filters or sorts by is a real column
//    with a real type (and an index where the old schema had one).
// 2. Anything only ever read and written as a whole blob, an itinerary, a
//    gallery, an SEO block, stays JSON. Splitting those into child tables
//    would buy nothing: nothing filters on them, and the admin UI PUTs the
//    entire array back on every save.
//
// Primary keys are UUIDs. The API serializes each row with `_id` AND `id` both
// set to that UUID, because the web app (a separate repo) types `_id` on every
// interface. See src/utils/serialize.js.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts `url` here, the connection string is supplied by
// prisma.config.ts for the CLI, and by the adapter in src/config/db.js for the
// client at runtime.
datasource db {
  provider = "postgresql"
}

enum Status {
  draft
  published
}

enum Country {
  Kenya
  Tanzania
  Uganda
  Rwanda
  Zanzibar
}

/// Was a Mongoose discriminator key. Now a plain column: the subtype-specific
/// fields below are nullable and only meaningful for their own category.
enum TourCategory {
  SafariExpedition
  WeekendEscape
}

enum Difficulty {
  easy
  moderate
  challenging
}

enum FaqGroup {
  general
  booking
  travel
  payment
}

enum EnquiryType {
  contact
  booking
}

/// The enquiry lifecycle, in pipeline order. `new` means nobody owns it yet;
/// everything from `assigned` onwards has an owner. `won` and `lost` are both
/// terminal, kept distinct so the two outcomes can be counted separately,
/// which a single `closed` state would have thrown away.
///
/// Replaces the old read/responded/archived mailbox states: `read` said only
/// that someone had opened the record, which the auto-mark-read behaviour set
/// even when nobody acted on it.
enum EnquiryStatus {
  new
  assigned
  in_progress
  quoted
  won
  lost
}

/// What an activity entry records. `note` is the only one a human writes
/// freely; the rest are appended by the action that caused them.
enum EnquiryEventType {
  created
  status_change
  assigned
  unassigned
  note
  contacted
}

enum AdminRole {
  admin
  editor
}

model Tour {
  id          String       @id @default(uuid()) @db.Uuid
  title       String       @db.VarChar(140)
  slug        String       @unique
  summary     String       @db.VarChar(300)
  description String

  priceFrom Decimal @db.Decimal(12, 2)
  currency  String  @default("KES") @db.VarChar(3)

  durationDays   Int
  durationNights Int
  groupSizeMax   Int        @default(12)
  difficulty     Difficulty @default(moderate)

  rating      Decimal @default(4.8) @db.Decimal(2, 1)
  reviewCount Int     @default(0)

  destinationId String?      @map("destination_id") @db.Uuid
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  countries Country[]

  highlights String[]
  inclusions String[]
  exclusions String[]

  /// Array of { day, title, description, activities[], meals[], accommodation }.
  itinerary Json @default("[]")

  /// { url, alt, caption? }
  heroImage Json
  /// Array of the same image shape.
  gallery   Json @default("[]")

  featured    Boolean      @default(false)
  bestSelling Boolean      @default(false)
  status      Status       @default(draft)
  order       Int          @default(0)
  category    TourCategory

  /// { metaTitle?, metaDescription?, ogImage? }
  seo Json?

  // --- SafariExpedition only ---
  parks                   String[]
  gameDriveCount          Int?
  conservancyFeesIncluded Boolean?

  // --- WeekendEscape only ---
  departsFrom  String?
  weekendDates DateTime[] @db.Date

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  enquiries Enquiry[]

  @@index([status, featured, order])
  @@index([category, status])
  @@index([destinationId])
  @@map("tours")
}

model Destination {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @db.VarChar(120)
  slug         String  @unique
  country      Country
  tagline      String? @db.VarChar(180)
  categoryLabel String @default("Destination") @map("category_label")
  overview     String

  heroImage Json @map("hero_image")
  cardImage Json @map("card_image")

  highlights String[]

  /// { months: string[], note?: string }
  bestTime Json? @map("best_time")
  /// Array of { name, slug, blurb?, image?, bestTime?, highlights[] }.
  /// Anchor targets on the destination page; never queried individually.
  parks    Json  @default("[]")

  featured Boolean @default(false)
  status   Status  @default(draft)
  order    Int     @default(0)
  seo      Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tours     Tour[]

  @@index([country, status, order])
  @@map("destinations")
}

model BlogPost {
  id      String @id @default(uuid()) @db.Uuid
  title   String @db.VarChar(160)
  slug    String @unique
  excerpt String @db.VarChar(300)
  content String

  coverImage Json @map("cover_image")
  /// { name, avatar? }
  author     Json @default("{\"name\":\"Lekker Tours\"}")

  tags           String[]
  readingMinutes Int      @default(4) @map("reading_minutes")
  publishedAt    DateTime @default(now()) @map("published_at")

  featured Boolean @default(false)
  status   Status  @default(draft)
  seo      Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@index([tags], type: Gin)
  @@map("blog_posts")
}

model Testimonial {
  id             String  @id @default(uuid()) @db.Uuid
  authorName     String  @map("author_name") @db.VarChar(120)
  authorLocation String? @map("author_location") @db.VarChar(120)
  /// { url?, alt? }
  avatar         Json?
  quote          String  @db.VarChar(600)
  rating         Int     @default(5)

  tourName    String?   @map("tour_name")
  travelledOn DateTime? @map("travelled_on") @db.Date

  featured Boolean @default(false)
  status   Status  @default(draft)
  order    Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, featured, order])
  @@map("testimonials")
}

/// Named `Faq`, not `FAQ`: Prisma derives the client delegate by lowercasing
/// the first letter only, so `model FAQ` would be reached as `prisma.fAQ`.
model Faq {
  id       String   @id @default(uuid()) @db.Uuid
  question String   @unique @db.VarChar(240)
  answer   String
  group    FaqGroup @default(general)
  order    Int      @default(0)
  status   Status   @default(draft)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, group, order])
  @@map("faqs")
}

model Enquiry {
  id    String      @id @default(uuid()) @db.Uuid
  type  EnquiryType
  name  String      @db.VarChar(120)
  email String
  phone String?     @db.VarChar(40)

  // Contact-form fields.
  expeditionInterest String?  @map("expedition_interest")
  budgetUSD          Decimal? @map("budget_usd") @db.Decimal(12, 2)
  message            String?

  // Booking-form fields.
  tourId     String?   @map("tour_id") @db.Uuid
  tour       Tour?     @relation(fields: [tourId], references: [id], onDelete: SetNull)
  tourTitle  String?   @map("tour_title")
  travelDate DateTime? @map("travel_date") @db.Date
  /// { adults, children, infants }, totalGuests is computed on serialize.
  guests     Json?

  /// Human-readable handle, e.g. "ENQ-2609-0042". Quoted at customers over the
  /// phone and in email subjects, where a UUID is unusable. Nullable only so
  /// the column could be backfilled; every row written since has one.
  reference String? @unique @db.VarChar(20)

  status     EnquiryStatus @default(new)
  adminNotes String?       @map("admin_notes")
  source     String        @default("website")

  /// Who owns it. SetNull rather than Cascade: removing a staff account must
  /// return their enquiries to the unassigned pool, never delete them.
  assigneeId String?    @map("assignee_id") @db.Uuid
  assignee   AdminUser? @relation("EnquiryAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignedAt DateTime?  @map("assigned_at")

  /// Last time someone recorded contact with the customer, and when they next
  /// intend to. Together these drive the "needs attention" filter, which is the
  /// one view that stops an enquiry going quiet for a week unnoticed.
  lastContactedAt DateTime? @map("last_contacted_at")
  followUpAt      DateTime? @map("follow_up_at")

  /// Set once when the enquiry first reaches a terminal state, so time-to-close
  /// can be measured without replaying the event log.
  closedAt DateTime? @map("closed_at")

  events EnquiryEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([assigneeId, status])
  /// Drives the follow-up queue: overdue rows, soonest first.
  @@index([followUpAt])
  @@map("enquiries")
}

/// One row per month, holding the last reference number issued for it.
///
/// Exists so a reference can be allocated in a single atomic UPDATE rather than
/// read-then-guess: concurrent submissions otherwise compute the same next
/// number and all but one are rejected by the unique index on Enquiry.reference.
model EnquiryReferenceCounter {
  /// 'YYMM', matching ENQ-YYMM-NNNN.
  period  String @id @db.VarChar(4)
  lastSeq Int    @default(0) @map("last_seq")

  @@map("enquiry_reference_counters")
}

/// Append-only history for one enquiry. Nothing here is ever updated or
/// deleted, correcting a mistake means adding another entry.
///
/// Separate from AuditLog on purpose: that table records access-control
/// changes for security review, this one is the customer-facing story of an
/// enquiry and is shown in the admin UI beside it.
model EnquiryEvent {
  id String @id @default(uuid()) @db.Uuid

  enquiryId String  @map("enquiry_id") @db.Uuid
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  type EnquiryEventType

  /// Null for the `created` entry, which the public form triggers with nobody
  /// signed in, and for anything a future automation appends.
  actorId    String?    @map("actor_id") @db.Uuid
  actor      AdminUser? @relation("EnquiryEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// Kept alongside the relation so a deleted account still reads as a name
  /// rather than a blank, the same way audit_log keeps actor_email.
  actorName  String?    @map("actor_name")

  /// One line describing what happened, written at append time so the UI never
  /// has to reconstruct wording from the type and the payload.
  summary String @db.VarChar(300)

  /// Free text for `note`; null otherwise.
  note String?

  /// Type-specific detail, e.g. { from: "new", to: "assigned" }.
  meta Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([enquiryId, createdAt])
  @@map("enquiry_events")
}

/// Singleton. The `key` column is unique and always 'primary', which is what
/// makes the upsert in SiteSettings.getSingleton() safe to call concurrently.
model SiteSettings {
  id  String @id @default(uuid()) @db.Uuid
  key String @unique @default("primary")

  hero        Json
  values      Json @default("[]")
  contact     Json
  socials     Json @default("{}")
  newsletter  Json
  footerBlurb String @map("footer_blurb")
  seo         Json

  /// { youtubeId?: string }, the film embedded on the homepage. Stored as
  /// JSON rather than a bare column so further video options (a poster image,
  /// a caption) can be added without another migration.
  video       Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  /// bcrypt digest. Never selected by default, see adminUsers.findByEmail().
  passwordHash String    @map("password_hash")
  name         String    @default("Administrator")
  /// Legacy coarse role, kept in step with `role.name` by the user controller.
  /// Still read by requireRole() on routes that have not moved to permission
  /// checks, and by any JWT issued before the roles table existed.
  role         AdminRole @default(admin)
  lastLoginAt  DateTime? @map("last_login_at")

  /// Nullable so the column could be backfilled before it was populated. A user
  /// without a role holds no permissions at all.
  roleId String? @map("role_id") @db.Uuid
  roleRef Role?  @relation(fields: [roleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  auditEntries AuditLog[]

  assignedEnquiries Enquiry[]      @relation("EnquiryAssignee")
  enquiryEvents     EnquiryEvent[] @relation("EnquiryEventActor")

  @@index([roleId])
  @@map("admin_users")
}

/// A named set of permissions. Seeded with Administrator/Editor/Author/
/// Enquiries (see config/permissions.js), then editable by anyone holding
/// `roles.manage`.
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(60)
  description String  @default("") @db.VarChar(300)

  /// Permission strings from config/permissions.js. A plain array rather than a
  /// join table: the set is small, always read whole, and never queried by
  /// individual permission.
  permissions String[]

  /// The Administrator role. Always holds every permission, including ones
  /// added by a later release, and cannot be edited, renamed or deleted.
  locked Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users AdminUser[]

  @@map("roles")
}

/// Append-only record of access changes: who did what to whom.
///
/// `actorId` is SetNull rather than Cascade, deleting an account must not
/// erase the history of what that account did. actorEmail preserves the
/// identity after the row is gone.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  actorId    String?    @map("actor_id") @db.Uuid
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String     @map("actor_email")

  /// e.g. 'user.create', 'user.role_change', 'role.update', 'user.delete'.
  action String @db.VarChar(60)

  /// What was acted on. Kept as loose text so a deleted target is still legible.
  targetType  String? @map("target_type") @db.VarChar(40)
  targetId    String? @map("target_id") @db.Uuid
  targetLabel String? @map("target_label")

  /// { before?, after? }, only the fields that changed. Never a password.
  changes Json @default("{}")

  ip String? @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorId])
  @@map("audit_log")
}
