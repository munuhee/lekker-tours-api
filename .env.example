# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Matches docker-compose.yml, so `docker compose
# up -d` and this value work together out of the box.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/lekker_tours?schema=public

# Origin of the Next.js app (the lekker-tours-web repo).
# Used for CORS and for the revalidation callback.
WEB_ORIGIN=http://localhost:3000

# This API's own public origin. Baked into uploaded-image URLs, which are
# stored on content rows, so in production this MUST be the deployed
# hostname — otherwise every uploaded image points at localhost.
# Must match NEXT_PUBLIC_API_URL in the lekker-tours-web repo.
PUBLIC_API_URL=http://localhost:4000

# Secret used to sign admin JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Shared secret for the Express -> Next revalidation webhook.
# Must match REVALIDATE_SECRET in the lekker-tours-web repo's .env.local.
REVALIDATE_SECRET=change-me-too

# Seeded first administrator (used by `npm run seed:admin`).
ADMIN_EMAIL=admin@lekkertours.com
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_NAME=Lekker Administrator
